{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Chicago",
  "schedule": ["before 9am on Monday"],
  "customManagers": [
    {
      "description": "Update the Java major version passed to setup-clojure in CI workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.forgejo/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["java-version:\\s*['\"]?(?<currentValue>\\d+)['\"]?"],
      "depNameTemplate": "java",
      "packageNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "extractVersionTemplate": "^(?<version>\\d+)"
    },
    {
      "description": "Update the Java major version embedded in the clojure and eclipse-temurin image tags in the Dockerfile",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "clojure:temurin-(?<currentValue>\\d+)-lein",
        "eclipse-temurin:(?<currentValue>\\d+)-jre"
      ],
      "depNameTemplate": "java",
      "packageNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "extractVersionTemplate": "^(?<version>\\d+)"
    }
  ],
  "packageRules": [
    {
      "description": "Group Clojure dependency updates into a single PR",
      "matchManagers": ["leiningen"],
      "registryUrls": ["https://repo.clojars.org", "https://repo1.maven.org/maven2"],
      "groupName": "Clojure dependencies"
    },
    {
      "description": "Group mise tool version updates",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "Keep Java in step across mise.toml, CI workflows, and the Dockerfile",
      "matchManagers": ["mise", "custom.regex"],
      "matchDepNames": ["java"],
      "groupName": "Java"
    },
    {
      "description": "Leave the eclipse-temurin Java major version to the Java group above. The dockerfile manager names the package with its registry, so match both forms",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["eclipse-temurin", "docker.io/eclipse-temurin"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep PostgreSQL in step across docker-compose.yaml and the CI workflows",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "docker.io/postgres"],
      "groupName": "PostgreSQL"
    },
    {
      "description": "Hold PostgreSQL major upgrades for approval on the Dependency Dashboard; production decides the major version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "docker.io/postgres"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Ignore custom internal Docker images",
      "matchPackageNames": ["dgknght/datomic-pro"],
      "enabled": false
    }
  ]
}
