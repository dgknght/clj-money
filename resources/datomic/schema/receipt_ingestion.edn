[{:db/ident :receipt-ingestion/entity
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "The entity for which the receipt is being read"}
 {:db/ident :receipt-ingestion/image
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "The image of the receipt"}
 {:db/ident :receipt-ingestion/status
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "The progress of the read (pending, processing, complete, failed, rejected)"}
 {:db/ident :receipt-ingestion/receipt
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "The receipt read from the image, serialized as edn"}
 {:db/ident :receipt-ingestion/error
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "The reason the read failed"}
 {:db/ident :receipt-ingestion/failure-reason
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "Why the read failed, when it's known: not-a-receipt, when the model says it wasn't given one"}
 {:db/ident :receipt-ingestion/transaction
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "The transaction created from the receipt"}
 {:db/ident :receipt-ingestion/rejection-reason
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Why the user rejected the transaction created from the receipt"}
 {:db/ident :receipt-ingestion/message-id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "The Message-ID of the email the receipt was read from, so that it isn't read again"}]
